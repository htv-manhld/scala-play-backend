# User Service Routes
# Health check
GET     /health                     controllers.HealthController.health()

# Metrics for Prometheus
GET     /metrics                    controllers.MetricsController.metrics()

# Authentication API endpoints
POST    /api/auth/login             controllers.AuthController.login()
GET     /api/auth/verify            controllers.AuthController.verifyToken()
POST    /api/auth/refresh           controllers.AuthController.refreshToken()
POST    /api/auth/logout            controllers.AuthController.logout()
PUT     /api/auth/change-password   controllers.AuthController.changePassword()
POST    /api/auth/forgot-password   controllers.AuthController.forgotPassword()
POST    /api/auth/reset-password    controllers.AuthController.resetPassword()

# User API endpoints
GET     /api/users                  controllers.UserController.getAllUsers(limit: Int ?= 10000, search: Option[String] ?= None, orderBy: Option[String] ?= None, orderDirection: Option[String] ?= None, ignoreId: Option[Long] ?= None, status: Option[Int] ?= None, createdFrom: Option[String] ?= None, createdTo: Option[String] ?= None)
GET     /api/users/paginated        controllers.UserController.getUsersPaginated(page: Int ?= 0, size: Int ?= 20, search: Option[String] ?= None, orderBy: Option[String] ?= None, orderDirection: Option[String] ?= None, ignoreId: Option[Long] ?= None, status: Option[Int] ?= None, createdFrom: Option[String] ?= None, createdTo: Option[String] ?= None)
GET     /api/users/:id              controllers.UserController.getUser(id: String)
GET     /api/users/by-email/:email  controllers.UserController.getUserByEmail(email: String)
POST    /api/users                  controllers.UserController.createUser()
PUT     /api/users/:id              controllers.UserController.updateUser(id: String)
PUT     /api/users/:id/email        controllers.UserController.changeUserEmail(id: String)
DELETE  /api/users/:id              controllers.UserController.deleteUser(id: String)